# Aeethod Studio — Admin Authentication Environment Variables
# Copy this file to .env.local for local development.
# On Vercel / Production, add these variables in your Project Settings -> Environment Variables.

# Authorized Admin Email
AEETHOD_ADMIN_EMAIL=studio@aeethod.com

# Admin Password Hash (scrypt format generated with: node scripts/generate-hash.js "YourPassword")
AEETHOD_ADMIN_PASSWORD_HASH=scrypt:284a9deef6912b278be959052a0e0e48:d081139de11580ff256eb1152103569b9bd6520ec05af511ae03b0d88480911f8c55a966506f244859bae615634d9a8efff848bb773232a04e5a8c6da2e77976

# Secret key for HMAC-SHA256 session token signing (generate a random 64-char hex string)
AEETHOD_AUTH_SECRET=1b9e2a62ba284d7712247f6d78d84e7468bb0f8b8217c2014c1de3ef743b76c8

# ─── Supabase — Analytics Database ───────────────────────────────────────
# Get these from: Supabase Dashboard → Settings → API

# Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://lgskrbzmcuipxvgxqjur.supabase.co

# Supabase publishable (anon) key — safe for browser exposure
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Supabase service role key — SERVER ONLY, never expose to browser
# This key bypasses Row Level Security. Treat it like a database password.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
